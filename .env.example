# Copy to .env.local and fill in. .env.local is gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret — service_role key from Supabase dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=
# Web Push public key (safe to expose in the browser). The matching
# VAPID_PRIVATE_KEY / VAPID_SUBJECT live only as Supabase Edge Function
# secrets (send-push), never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
